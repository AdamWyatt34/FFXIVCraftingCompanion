{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "FFXIV.Application": "Warning",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning",
      "Polly": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=ffxiv_crafting;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=true;Encrypt=false"
  },
