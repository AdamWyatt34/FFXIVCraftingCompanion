{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "FFXIV": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "FFXIV": "Information"
      }
    }
  },
  "Redis": {
    "Enabled": false
  },
  "DataSync": {
    "FullSyncOnStartup": false,
    "BatchSize": 50
  },
  "ApplyMigrationsOnStartup": false
}
