{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "XivApi": {
    "BaseUrl": "https://v2.xivapi.com",
    "RateLimitPermitCount": 15,
    "RateLimitWindowSeconds": 1,
    "DefaultPageSize": 500,
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379"
  },
  "DataSync": {
    "EnableAutoSync": true,
    "SyncScheduleCron": "0 4 * * *",
    "FullSyncOnStartup": true,
    "BatchSize": 100,
    "XivApiRequestsPerSecond": 15,
    "SyncSources": true,
    "SyncGathering": true,
    "SyncVendors": true,
    "SyncScrips": true,
    "EnrichFromGarlandTools": false
  },
  "GarlandTools": {
    "BaseUrl": "https://garlandtools.org",
    "RateLimitPermitCount": 2,
    "RateLimitWindowSeconds": 1,
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3
  }
}
