{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/data-fetch.mjs",
    "data:fetch": "node scripts/data-fetch.mjs",
    "build": "next build --webpack",
    "test": "vitest run",
    "start": "next start",
    "lint": "eslint",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "wasm:build": "node scripts/wasm-build.mjs",
    "wasm:check": "node scripts/wasm-check.mjs",
    "test:e2e": "cross-env NEXT_PUBLIC_API_URL=http://localhost:3101 FFXIV_DATA_DIR=e2e/fixtures/data npm run build && playwright test"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.76.2",
    "lucide-react": "^0.563.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@serwist/next": "^9.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.5"
  }
}
