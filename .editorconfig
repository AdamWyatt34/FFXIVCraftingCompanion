# Editor defaults for the repository; language tooling (dotnet format, rustfmt, prettier/eslint) refines them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = when_multiline:suggestion

[*.rs]
indent_size = 4

[*.{ps1,psm1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[Makefile]
indent_style = tab

# Analyzer severities for the .NET projects (AnalysisLevel latest-recommended, Directory.Build.props).
# The logging-performance rules want LoggerMessage delegates for every log call, which this
# code base's logging volume does not justify; the two API-shape rules would trade interfaces
# and read-only collections for concrete types. They stay visible in the IDE as suggestions.
[*.cs]
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion
dotnet_diagnostic.CA1859.severity = suggestion
dotnet_diagnostic.CA1861.severity = suggestion
dotnet_diagnostic.CA1805.severity = suggestion

# xUnit test names follow Method_Scenario_Expectation; CA1707 (no underscores) does not apply there.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1305.severity = suggestion
