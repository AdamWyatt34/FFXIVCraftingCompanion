  "product": {
    "mission": "Crafting, gathering, gear, and market companion for FFXIV players, with a rotation simulator and solver.",
    "direction": [
      {
        "theme": "Port the crafting engine to a Rust crate (crates/xiv-craft) with byte-for-byte parity against the C# engine, targeting wasm32",
        "why": "One engine implementation that can run client-side and be shared by future solver work",
        "status": "landed",
        "added": "2026-09-11",
        "source": "elicited"
      },
      {
        "theme": "Run the rotation solver client-side via wasm",
        "why": "Remove server compute from the solver hot path",
        "status": "exploring",
        "added": "2026-09-11",
        "source": "elicited"
      }
    ]
  },
  "maintenancePosture": "active",
  "desiredPatterns": [
    {
      "name": "Clean Architecture layering: Domain -> Application -> Infrastructure/Api; Domain has no package or project dependencies",
      "status": "enforced",
      "detected": true
    },
    {
      "name": "MediatR request/handler pipeline in Application (this repo uses MediatR, not the custom Result mediator from global conventions)",
      "status": "enforced",
      "detected": true
    },
    {
      "name": "Crafting engine and solvers live only in crates/xiv-craft and reach the browser through crates/xiv-craft-wasm; C# holds RotationActionCatalog (ids and names) and no engine rule",
      "status": "enforced",
      "detected": true
    },
    {
      "name": "EF Core + ASP.NET Identity + JWT bearer auth in Infrastructure; schema changes via EF migrations",
      "status": "enforced",
      "detected": true
    },
    {
      "name": "Next.js App Router with server components by default; client components only where interaction requires",
      "status": "enforced",
      "detected": true
    },
    {
      "name": "Tests: xUnit + FluentAssertions + NSubstitute; solver benchmarks driven by crates/xiv-craft/tests/benchmarks/solver-benchmarks.json",
      "status": "enforced",
      "detected": true
    },
    {
      "name": "crates/xiv-craft is the engine reference: correctness pinned by tests/reference_parity.rs (Raphael/Teamcraft arithmetic), tests/goldens/ snapshots regenerated only for an intended engine change, and the solver benchmarks",
      "status": "enforced",
      "detected": true
    }
  ],
  "noGoZones": [
    {
      "path": "src/FFXIV.Infrastructure/Migrations/",
      "reason": "EF Core migrations are generated and human-reviewed; never hand-edit or regenerate without a human"
    },
    {
      "path": "infra/",
      "reason": "Bicep templates drive the production Azure deployment"
    },
    {
      "path": ".github/workflows/",
      "reason": "CI and deploy pipelines; changes need a human"
    },
    {
      "path": "src/FFXIV.Api/appsettings.Production.json",
      "reason": "Production configuration"
    },
    {
      "path": "crates/xiv-craft/tests/benchmarks/solver-benchmarks.json",
      "reason": "Hand-maintained solver benchmark fixtures pin solver behaviour. crates/xiv-craft/tests/goldens/ is generator-only output of the snapshot tests (XIV_CRAFT_GENERATE=1); never hand-edit it, and regenerate only when an engine change is intended. dotnet-random.json is frozen .NET output and is not regenerated"
    }
  ],
  "prGates": [
    "dotnet build FFXIVCraftingCompanion.slnx --configuration Release succeeds with no warnings-as-errors regressions",
